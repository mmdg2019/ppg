<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account_reports.general_ledger_report" model="account.report">
        <field name="column_ids">
            <record id="general_ledger_report_creditor_debitor" model="account.report.column">
                <field name="name">Creditor/Debitor</field>
                <field name="expression_label">creditor_debitor</field>
                <field name="figure_type">string</field>
            </record>
            <record id="general_ledger_report_move_ref" model="account.report.column">
                <field name="name">Reference</field>
                <field name="expression_label">move_ref</field>
                <field name="figure_type">string</field>
            </record>
            <record id="general_ledger_report_label" model="account.report.column">
                <field name="name">Label</field>
                <field name="expression_label">line_name</field>
                <field name="figure_type">string</field>
            </record>
        </field>
        <field name="line_ids">
            <record id="account_reports.general_ledger_custom_engine_line" model="account.report.line">
                <field name="expression_ids">
                    <record id="general_ledger_line_creditor_debitor" model="account.report.expression">
                        <field name="label">creditor_debitor</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_custom_engine_general_ledger</field>
                        <field name="subformula">creditor_debitor</field>
                    </record>
                    <record id="general_ledger_line_move_ref" model="account.report.expression">
                        <field name="label">move_ref</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_custom_engine_general_ledger</field>
                        <field name="subformula">move_ref</field>
                    </record>
                    <record id="general_ledger_line_label" model="account.report.expression">
                        <field name="label">line_name</field>
                        <field name="engine">custom</field>
                        <field name="formula">_report_custom_engine_general_ledger</field>
                        <field name="subformula">line_name</field>
                    </record>
                </field>
            </record>
        </field>
    </record>

</odoo>
