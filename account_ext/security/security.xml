<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="group_partner_create_disable" model="res.groups">
        <field name="name">Disable Contact Creation</field>
    </record>

    <record model="ir.module.category" id="module_category_payment_terms">
        <field name="name">Payment Terms Selection</field>
        <field name="sequence">9</field>
    </record>

    <record model="res.groups.privilege" id="res_groups_privilege_payment_terms">
        <field name="name">Payment Terms Selection</field>
        <field name="category_id" ref="account_ext.module_category_payment_terms"/>
        <field name="sequence">5</field>
    </record>

    <record id="group_payment_terms_permission" model="res.groups">
        <field name="name">User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="privilege_id" ref="res_groups_privilege_payment_terms"/>
    </record>
    
    <record id="group_payment_terms_permission_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="implied_ids" eval="[(4, ref('account_ext.group_payment_terms_permission'))]"/>
        <field name="privilege_id" ref="res_groups_privilege_payment_terms"/>
    </record>

</odoo>
