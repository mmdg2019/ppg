<odoo>
    <data>
        <record id="view_account_journal_form_inherit" model="ir.ui.view">
            <field name="name">account.journal.form.inherit</field>
            <field name="model">account.journal</field>
            <field name="inherit_id" ref="account.view_account_journal_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='code']" position="after">
                    <label for="sequence_number_next"/>
                    <div>
                        <field name="sequence_number_next" style="padding-right: 1.0em"/>
                    </div>
                    <!-- <field name="sequence_id" context="{'form_view_ref':'sequence_for_journal.ir_sequence_view_form'}" domain="[('prefix', 'ilike', code),('company_id', '=', company_id)]" default="True"/> -->
                    <field name="sequence_id" required= "type not in ['sale','purchase']" invisible= "type in ['sale','purchase']" context="{'form_view_ref':'sequence_for_journal.ir_sequence_view_form'}" domain="[('prefix', 'ilike', code),('company_id', '=', company_id)]" default="True"/>
                    <!-- <field name="refund_sequence"
                            attrs="{'invisible': [('type', 'not in', ['sale', 'purchase'])]}"
                            groups="base.group_no_one"/> -->
                     <!--make one of dedicated credit note sequences invisible -->
                    <field name="refund_sequence" invisible="1"                       
                            groups="base.group_no_one"/>
                    <label for="refund_sequence_number_next"
                            invisible= "type not in ['sale', 'purchase'] or refund_sequence != True"/>
                    <div invisible= "type not in ['sale', 'purchase'] or refund_sequence != True">
                        <field name="refund_sequence_number_next" style="padding-right: 1.0em"/>
                        <field name="refund_sequence_id" required="0"
                                groups="base.group_no_one"/>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
