<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_partner_view_form_account_ext" model="ir.ui.view">
            <field name="name">res.partner.view.form.inherit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="attributes">
                    <attribute name="create">false</attribute>
                </xpath>
                <xpath expr="//form" position="attributes">
                    <attribute name="edit">false</attribute>
                </xpath>
                <xpath expr="//field[@name='vat']" position="after">
                    <field name="show_payment_terms"/>
                </xpath>
            </field>
        </record>
        <record id="res_partner_view_form_permission" model="ir.ui.view">
            <field name="name">res.partner.view.form.permission</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="res_partner_view_form_account_ext"/>
            <!-- <field name="group_ids" eval="[(4, ref('account_ext.group_partner_creation_permission'))]"/> -->
            <field name="arch" type="xml">
                <xpath expr="//form" position="attributes">
                    <attribute name="create">true</attribute>
                </xpath>
                <xpath expr="//form" position="attributes">
                    <attribute name="edit">true</attribute>
                </xpath>
            </field>
        </record>
        <record id="res_partner_kanban_view_account_ext" model="ir.ui.view">
            <field name="name">res.partner.kanban.view.inherit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.res_partner_kanban_view"/>
            <field name="arch" type="xml">
                <xpath expr="//kanban" position="attributes">
                    <attribute name="create">false</attribute>
                </xpath>
            </field>
        </record>
        <record id="res_partner_kanban_view_permission" model="ir.ui.view">
            <field name="name">res.partner.kanban.view.permission</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="account_ext.res_partner_kanban_view_account_ext"/>
            <!-- <field name="group_ids" eval="[(4, ref('account_ext.group_partner_creation_permission'))]"/> -->
            <field name="arch" type="xml">
                <xpath expr="//kanban" position="attributes">
                    <attribute name="create">true</attribute>
                </xpath>
            </field>
        </record> 
        <record id="res_partner_tree_view_account_ext" model="ir.ui.view">
            <field name="name">res.partner.list.view.inherit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//list" position="attributes">
                    <attribute name="create">false</attribute>
                </xpath>
            </field>
        </record>
        <record id="res_partner_tree_view_permission" model="ir.ui.view">
            <field name="name">res.partner.list.view.form.permission</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="account_ext.res_partner_tree_view_account_ext"/>
            <!-- <field name="group_ids" eval="[(4, ref('account_ext.group_partner_creation_permission'))]"/> -->
            <field name="arch" type="xml">
                <xpath expr="//list" position="attributes">
                    <attribute name="create">true</attribute>
                </xpath>
            </field>
        </record>

        <!-- 6.3.2026: in Odoo 16, the following attributes were added via studio view; it does not work in Odoo 19 and thus moved here; -->
        <!-- no 'accounting_entries' group in Odoo 19; so groups are added to separate fields; currency_id is already invisible and thus no group added; -->
        <record id="view_partner_property_form_account_ext_inherit" model="ir.ui.view">
            <field name="name">res.partner.property.form.account_ext.inherit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="account.view_partner_property_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field=[@name='property_account_receivable_id']" position="attributes">
                    <attribute name="groups">account.group_account_manager,account.group_account_invoice</attribute>
                </xpath>
                <xpath expr="//page[@name='accounting']/group/group[1]/field=[@name='property_account_payable_id']" position="attributes">
                    <attribute name="groups">account.group_account_manager,account.group_account_invoice</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
