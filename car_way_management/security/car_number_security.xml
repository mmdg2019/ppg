<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="car_number_company_rule" model="ir.rule">
            <field name="name">Car Numbers: Multi-Company Rule</field>
            <field name="model_id" ref="model_car_number"/>
            <field name="global" eval="False"/>
            <field name="domain_force">
                  ['|', ('company_ids', '=', False), ('company_ids', 'in', company_ids)]
            </field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        
    </data>
</odoo>