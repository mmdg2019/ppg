<odoo>
    <!-- Form View -->
    <record id="view_move_form_car_info" model="ir.ui.view">
        <field name="name">account.move.form.car.info</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='journal_div']" position="after">
                <field name="car_number_id" 
                       widget="many2one" 
                       string="Car Number"/>
            </xpath>
        </field>
    </record>
</odoo>