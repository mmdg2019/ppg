<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Inherit Sale Order Form View to add car fields -->
    <record id="view_order_form_inherit_car_way" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.car.way</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_shipping_id']" position="after">
                <label for="car_number_id" string="Car Number"/>
                <div name="car_number_div" class="o_row">
                    <field name="car_number_id" widget="many2one" />
                    <span name="car_size_span" class="text-muted">Car Size: <field name="car_size" class="oe_inline" readonly="1"/></span>
                </div>
                <field name="partner_township_id" class="oe_inline" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='client_order_ref']" position="after">
                <group name="car_info_group" string="Car Information">
                    <field name="delivery_assign_status" />
                </group>
            </xpath>
        </field>
    </record>

    <!-- Car Way Specific List View -->
    <record id="view_sale_order_car_way_tree" model="ir.ui.view">
        <field name="name">sale.order.car.way.list</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <list
                decoration-info="delivery_assign_status=='assigned'"
                decoration-warning="delivery_assign_status=='pending'">
                <header>
                    <button name="open_export_wizard" string="Export to Excel"
                        type="object" class="btn-primary" icon="fa-file-excel-o" />
                    <button name="action_open_assign_wizard"
                        string="Assign by Township (Wizard)"
                        type="object"
                        class="btn-primary"
                        icon="fa-map-marker" />
                </header>
                <field name="name" string="Order Reference" />
                <field name="car_number_id" widget="many2one"
                    options="{'no_create': True}" />
                <field name="car_size" />
                <field name="partner_id" />
                <field name="date_order" />
                <field name="amount_total" />
                <field name="delivery_assign_status" widget="badge"
                    options="{'decoration-mapping': {
                           'pending': 'warning',
                           'assigned': 'info',
                           'delivered': 'success'
                       }}" />
            </list>
        </field>
    </record>

    <!-- Car Way Action -->
    <record id="action_car_way" model="ir.actions.act_window">
        <field name="name">Car Way</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('picking_ids.state', 'not in', ['done' , 'cancel'])]</field>
        <field name="context">
            {
            'search_default_group_township': 1,
            'group_by': 'partner_township_id',
            'default_delivery_assign_status': 'pending'
            }
        </field>
        <field name="search_view_id" ref="sale.view_sales_order_filter" />
        <field name="view_id" ref="car_way_management.view_sale_order_car_way_tree" />
    </record>
</odoo>
