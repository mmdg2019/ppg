<odoo>
    <data>
        <!-- Inherit the existing form view -->
        <record id="view_mrp_production_inherit" model="ir.ui.view">
            <field name="name">mrp.production.form.inherit</field>
            <field name="model">mrp.production</field>
            <field name="inherit_id" ref="mrp.mrp_production_form_view"/> 
            <field name="arch" type="xml">
                <!-- Find the position to add the field (after the payment_type field) -->
                
                <xpath expr="//label[@for='date_start']" position="before">                
                    <field name="date_deadline" readonly= "state in ['done','cancel']"/>
                </xpath>
                <field name='date_start' position="after">                    
                    <label for="date_finished" string="to" invisible= "id == False or state in ['draft', 'confirmed']"/>
                    <field name="date_finished" required="1" readonly= "state in ['done', 'cancel']"/>
                </field>                
            </field>
        </record>
    </data>
</odoo>
