<odoo>

    <record id="popular_reports.sale_target_line_list" model="ir.ui.view">
        <field name="name">Default list view for Sales Target Lines</field>
        <field name="model">popular_reports.sale_target.line</field>
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
            <list editable="top" decoration-success="ttl_sold_count &lt;&#61; max_sale_target_number and ttl_sold_count &gt;&#61; min_sale_target_number" decoration-danger="ttl_sold_count &gt; max_sale_target_number or ttl_sold_count &lt; min_sale_target_number">
                <field name="product_id" options="{&quot;no_create&quot;:true,&quot;no_open&quot;:true}"/>
                <field name="prouct_uom_id" string="UoM"/>
                <field name="min_sale_target_number" string="Minimum Target Quantity"/>
                <field name="max_sale_target_number" string="Maximum Target Quantity"/>
                <field name="ttl_sold_count" string="Sold Quantity" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="popular_reports.sale_target_line_search" model="ir.ui.view">
        <field name="name">Default search view for popular_reports.sale_target.line</field>
        <field name="model">popular_reports.sale_target.line</field>
        <field name="active" eval="True"/>
        <field name="arch" type="xml">
            <search string="Sales Target Line">
                <filter domain="[('status', '=', 'below')]" name="below_sale_target" string="Below Sales Target"/>
                <filter domain="[('status', '=', 'within')]" name="within_sale_target" string="Within Sales Target"/>
                <filter domain="[('status', '=', 'over')]" name="over_sale_target" string="Over Sales Target"/>
            </search>
        </field>
    </record>

    <record model="ir.actions.act_window" id="btn_sale_target_line">
        <field name="name">Sales Target Product List</field>
        <field name="context">{'default_sale_target_id': active_id, 'search_default_sale_target_id': True}</field>
        <field name="domain">[('sale_target_id', '=', active_id)]</field>
        <field name="res_model">popular_reports.sale_target.line</field>
        <field name="target">current</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
