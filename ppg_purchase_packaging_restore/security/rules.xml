<odoo>
    <record id="restore_job_company_rule" model="ir.rule">
        <field name="name">Restore jobs: all companies must be granted</field>
        <field name="model_id" ref="model_ppg_purchase_packaging_restore_job"/>
        <field name="domain_force">[('company_ids', 'not any', [('id', 'not in', user.company_ids.ids)])]</field>
    </record>
    <record id="restore_line_company_rule" model="ir.rule">
        <field name="name">Restore audit: granted companies</field>
        <field name="model_id" ref="model_ppg_purchase_packaging_restore_line"/>
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
    </record>
</odoo>
