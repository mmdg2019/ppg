<odoo>
    <data>
        <!-- Inherit the existing form view to add line-height to name field-->
        <record id="res_partner_form_inherit_name" model="ir.ui.view">
            <field name="name">res.partner.form.inherit.name</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/> 
            <field name="arch" type="xml">                
                <xpath expr="//form/sheet/div[hasclass('oe_title')]/h1/field[@name='name'][1]" position="attributes">
                    <attribute name="style">height:auto; line-height: 200%;</attribute> 
                </xpath>
                <xpath expr="//form/sheet/div[hasclass('oe_title')]/h1/field[@name='name'][2]" position="attributes">
                    <attribute name="style">height:auto; line-height: 200%;</attribute> 
                </xpath>
                <!-- Adding related_company_id field inside the accounting_entries group -->
                <xpath expr="//group[@name='accounting_entries']" position="inside">
                    <field name="related_company_id" placeholder="Select a related company"/>
                </xpath>                
            </field>
        </record> 
    </data>
</odoo>