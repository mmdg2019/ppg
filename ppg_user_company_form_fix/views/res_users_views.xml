<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_users_form_company_tags_without_color" model="ir.ui.view">
        <field name="name">res.users.form.company.tags.without.color</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_ids' and @widget='many2many_tags']" position="attributes">
                <attribute name="options">{'no_create': True}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
