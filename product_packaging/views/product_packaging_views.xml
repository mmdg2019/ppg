<odoo>
    <record id="view_product_packaging_form" model="ir.ui.view">
        <field name="name">product.packaging.form</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <form string="Product Packaging" class="hide_create_btn">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="uom_ids" widget="many2many_tags"/>
                        <field name="uom_id"/>
                        <field name="company_id"/>
                        <field name="sale_ok"/>
                        <field name="purchase_ok"/>
                    </group>
                </sheet>
            </form>
        </field>
     </record>
    <record id="view_product_packaging_list" model="ir.ui.view">
        <field name="name">product.packaging.list</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list string="Product Packaging" class="hide_create_btn">
                <field name="name"/>
                <field name="uom_ids" widget="many2many_tags"/>
                <field name="uom_id"/>
                <field name="company_id"/>
                <field name="sale_ok"/>
                <field name="purchase_ok"/>
            </list>
        </field>
    </record>
    <record id="view_product_packaging_search" model="ir.ui.view">
        <field name="name">product.packaging.search</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <search string="Product Packaging">
                <field name="name"/>
                <field name="uom_ids"/>
            </search>
        </field>
    </record>
    <record id="product_packaging_action" model="ir.actions.act_window">
        <field name="name">Product Packagings</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form,search</field>
        <field name="target">current</field>
        <field name="view_ids" eval="[(5, 0, 0),
			(0, 0, {'view_mode': 'list', 'view_id': ref('view_product_packaging_list')}),
			(0, 0, {'view_mode': 'form', 'view_id': ref('view_product_packaging_form')})]"/>
        <field name="search_view_id" ref="view_product_packaging_search"/>
    </record>
</odoo>