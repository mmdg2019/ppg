<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- TOWNSHIP TREE VIEW -->
    <record id="view_res_township_tree" model="ir.ui.view">
        <field name="name">res.township.tree</field>
        <field name="model">res.township</field>
        <field name="arch" type="xml">
            <tree string="Townships">
                <field name="name" />
                <field name="code" />
                <field name="city_id" />
                <field name="state_id" />
                <field name="country_id" />
                <field name="active" />
            </tree>
        </field>
    </record>

    <!-- TOWNSHIP FORM VIEW -->
    <record id="view_res_township_form" model="ir.ui.view">
        <field name="name">res.township.form</field>
        <field name="model">res.township</field>
        <field name="arch" type="xml">
            <form string="Township">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Township Name" />
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="country_id"
                                options="{'no_create': True}" />
                            <field name="state_id"
                                options="{'no_create': True}"
                                domain="[('country_id', '=', country_id)]" />
                            <field name="city_id"
                                options="{'no_create': True}"
                                domain="[('state_id', '=', state_id)]" />
                        </group>
                        <group>
                            <field name="code" />
                            <field name="active" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- TOWNSHIP SEARCH VIEW -->
    <record id="view_res_township_search" model="ir.ui.view">
        <field name="name">res.township.search</field>
        <field name="model">res.township</field>
        <field name="arch" type="xml">
            <search string="Search Township">
                <field name="name" />
                <field name="city_id" />
                <field name="state_id" />
                <field name="country_id" />
                <filter name="active_filter" string="Active" domain="[('active', '=', True)]" />
            </search>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_res_township" model="ir.actions.act_window">
        <field name="name">Townships</field>
        <field name="res_model">res.township</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p>Manage townships by country, state, and city.</p>
        </field>
    </record>

</odoo>