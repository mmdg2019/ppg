        <!-- For Warehouse Manager -->
        <record id="sale_order_inherited_form_sale_stock" model="ir.ui.view">
            <field name="name">sale.order.inherited.form.sale.stock</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale_stock.view_order_form_inherit_sale_stock"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_view_delivery']" position="attributes">
                    <attribute name="groups"></attribute>
                </xpath>
            </field>
        </record>

        <record id="sale_order_form_inherit_unit_price" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.unit.price</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='order_lines']/field[@name='order_line']/list/field[@name='price_unit']" position="before">                    
                    <field name="package_uom_id" invisible="not product_id"/>                    
                    <field name="package_uom_qty" invisible="not product_id or not package_uom_id"/>
                    <field name="sales_unit_price" readonly="not x_studio_editing_price_status" column_invisible="1"/>
                </xpath>
                <xpath expr="//page[@name='order_lines']/field[@name='order_line']/list/field[@name='price_unit']" position="attributes">
                    <attribute name="options">{'digits': [16, 2]}</attribute>                   
                </xpath>
                <xpath expr="//page[@name='order_lines']/field[@name='order_line']/list/field[@name='product_uom_id']" position="attributes">
                    <attribute name="domain">[('id', 'not in', packaging_uom_ids)]</attribute> 
                </xpath>
            </field>
        </record>
    </data>
</odoo>