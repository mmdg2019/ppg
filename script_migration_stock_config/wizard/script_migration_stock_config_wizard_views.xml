<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_script_migration_stock_config_wizard_form" model="ir.ui.view">
        <field name="name">script.migration.stock.config.wizard.form</field>
        <field name="model">script.migration.stock.config.wizard</field>
        <field name="arch" type="xml">
            <form string="Damage Receipt Loss Account">
                <sheet>
                    <group>
                        <field name="config_key" invisible="1"/>
                        <field name="summary" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_check" string="Check" type="object" class="oe_highlight"/>
                    <button name="action_run" string="Run" type="object"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_script_migration_stock_config_wizard" model="ir.actions.act_window">
        <field name="name">Damage Receipt Loss Account</field>
        <field name="res_model">script.migration.stock.config.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_script_migration_stock_config_wizard_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="stock.model_stock_location"/>
        <field name="binding_type">action</field>
        <field name="group_ids" eval="[(4, ref('base.group_no_one'))]"/>
        <field name="context">{'default_config_key': 'damage_receipt'}</field>
    </record>

