<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cost_sheet_two_form" model="ir.ui.view">
        <field name="name">cost.sheet.two.form</field>
        <field name="model">cost.sheet.two</field>
        <field name="arch" type="xml">
            <form string="Cost Sheet">
            	<header>
                        <button name="confirm_expired" string="Set TO Expired" type="object" class="oe_highlight"  invisible= "status == 'expired'"/>
                    
                    <button name="update_cost" string="Update Purchase Price" type="object" class="oe_highlight"/>
                        <field name="status" widget="statusbar" statusbar_visible="active,expired"/>
                </header>
		        <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" icon="fa-th" name="action_manufacturing_list">
                            <field name="manu_count" string="ManufactruingOrders" widget="statinfo"/>
                        </button>
                    </div>
		        
		        	<div class="oe_title">
                        <h1>
                             <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="status=='expired'" options="{'no_create': True}"/>
                            <field name="product_id" readonly="status=='expired'" options="{'no_create': True}"/>
                            <field name="product_uom_id" groups="uom.group_uom" options="{'no_open':True,'no_create':True,'no_create_edit':True}"/>
                            <field name="bom_id" readonly="status=='expired'" options="{'no_create': True}"/>
                            <field name="raw_ids" widget="many2many_tags" readonly="status=='expired'" options="{'no_create': True}"/>
                            <field name="avg_sale" readonly="status=='expired'" />
                            <field name="material_cost" readonly="status=='expired'"/>
                            <field name="labcost" readonly="status=='expired'"/>
                            <field name="total" readonly="status=='expired'"/>
                            <field name="plb" readonly="status=='expired'"/>
                            <field name="unitcost" readonly="status=='expired'"/>
                            <field name="qty" readonly="status=='expired'"/>
                            <field name="amount" readonly="status=='expired'"/>
                            <field name="bag" readonly="status=='expired'"/>
                            <field name="label" readonly="status=='expired'"/>
                            <field name="metal" readonly="status=='expired'"/>
                            <field name="box" readonly="status=='expired'"/>
                            <field name="other" readonly="status=='expired'"/>
                            <field name="meter" readonly="status=='expired'"/>
                            <field name="diesel" readonly="status=='expired'"/>
                            <field name="facttotal" readonly="status=='expired'"/>
                        </group>
                        
                        <group>
                            <field name="date" readonly="status=='expired'"/>
                            <field name="start_date" readonly="status=='expired'" invisible="avg_sale == False"/>
                            <field name="end_date" readonly="status=='expired'" invisible="avg_sale == False"/>
                            <field name="pop" readonly="status=='expired'"/>
                            <field name="new1" readonly="status=='expired'"/>
                            <field name="new2" readonly="status=='expired'"/>
                            <field name="new3" readonly="status=='expired'"/>
                            <field name="new4" readonly="status=='expired'"/>
                            <field name="ppitotal" readonly="status=='expired'"/>
                            <field name="originp" readonly="status=='expired'"/>
                            <field name="discount" readonly="status=='expired'"/>
                            <field name="sellprice" readonly="status=='expired'"/>
                            <field name="prototal" readonly="status=='expired'"/>
                            <field name="proeach" readonly="status=='expired'"/>
                            <field name="fselprice" readonly="status=='expired'"/>
                            <field name="company_id" options="{'no_open':True,'no_create':True,'no_create_edit':True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="costsheet_lines" >
                                <list string="CostSheet Lines" create="false" delete="false" editable="bottom">
                                    <field name="product_id" readonly="True" force_save="1"/>
                                    <field name="category_id" readonly="True" force_save="1"/>
                                    <field name="total_amt" readonly="True" force_save="1"/>
                                    <field name="total_qty" readonly="True" force_save="1"/>
                                    <field name="total" readonly="True" force_save="1"/>
                                    <field name="qty" readonly="True" force_save="1"/>
                                    <field name="product_uom_id" groups="uom.group_uom" readonly="True" force_save="1"/>
                                    <field name="cost" readonly="True" force_save="1"/>
                                </list>
                            </field>
                        </page>                        
                    </notebook>
		        </sheet>
            </form>
        </field>
    </record>

    <record id="view_cost_sheet_two_list" model="ir.ui.view">
        <field name="name">cost.sheet.two.list</field>
        <field name="model">cost.sheet.two</field>
        <field name="arch" type="xml">
            <list string="Cost Sheet">
                <field name="name"/>
                <field name="product_id"/>
            </list>
        </field>
    </record>
    
    
   <record id="cost_sheet_two_view_search" model="ir.ui.view">
        <field name="name">cost.sheet.two</field>
        <field name="model">cost.sheet.two</field>
        <field name="arch" type="xml">
            <search string="Cost Sheet">
            	<field name="name" filter_domain="['|',('name', 'ilike', self),('product_id', 'ilike', self)]"/>
            	<field name="product_id" />
                <field name="status" />
                <filter string="Active" name="active" domain="[('status', '=', 'active')]"/>
                <filter string="Expired" name="expired" domain="[('status', '=', 'expired')]"/>
                <group>
                    <filter string="Product" name="product" domain="[]" context="{'group_by':'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_view_cost_sheet_two_list" model="ir.actions.act_window">
        <field name="name">Cost Sheet</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">cost.sheet.two</field>
        <field name="view_mode">list,form</field>
        <field name="context">{"search_default_cost": True}</field>
    </record>

   <menuitem action="action_view_cost_sheet_two_list"
             id="menu_action_cost_sheet_two_list"
             parent="mrp.menu_mrp_root"
             name="Cost Sheet Two"
             sequence="30"/>
    
    <record id="view_mrp_production_form_inherit" model="ir.ui.view">
            <field name="name">mrp.production.form.inherit</field>
            <field name="model">mrp.production</field>
			<field name="inherit_id" ref="mrp.mrp_production_form_view"/>
            <field name="arch" type="xml">
				<xpath expr="//field[@name='bom_id']" position="after">
					<field name="costsheet_id" options="{'no_create': True,'no_open': True}"/>
                    <field name="partner_id" options="{'no_create_edit':True}"/>
				</xpath>
			</field>
	</record>
    
    <record id="view_mrp_bom_form_inherit" model="ir.ui.view">
            <field name="name">mrp.bom.form.inherit</field>
            <field name="model">mrp.bom</field>
			<field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
            <field name="arch" type="xml">
				<xpath expr="//field[@name='product_tmpl_id']" position="before">
					<field name="name"/>
				</xpath>
			</field>
	</record>
             
   
</odoo>

