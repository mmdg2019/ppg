<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Inherit the stock.move.line list view (Move History) -->
        <record id="view_move_line_tree_inherit_unit_cost" model="ir.ui.view">
            <field name="name">stock.move.line.inherit.unit.cost</field>
            <field name="model">stock.move.line</field>
            <field name="inherit_id" ref="stock.view_move_line_tree"/>
            <field name="arch" type="xml">
                
                <field name="quantity" position="after">
                    <field name="company_currency_id" column_invisible="1"/>
                    <field name="unit_cost" widget="monetary" options="{'currency_field': 'company_currency_id'}"/>
                </field>
                <field name="product_uom_id" position="after">
                    <field name="total_value" widget="monetary" options="{'currency_field': 'company_currency_id'}"/>
                </field>
            </field>
        </record>
    </data>
</odoo>