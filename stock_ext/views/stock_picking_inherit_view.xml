<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Inherit the stock.picking form view -->
        <record id="view_picking_form_inherit" model="ir.ui.view">
            <field name="name">stock.picking.form.inherit</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <!-- Locate the field you want to modify -->
                <field name="picking_type_id" position="attributes">
                    <attribute name="readonly">state == 'draft'</attribute>
                </field>
            </field>
        </record>
        
        <!-- remove Existing group and add Inventory/Administrator group to Inventory/Reporting/Valuation Menu -->
        <!-- <record id="stock_account.menu_valuation" model="ir.ui.menu">
            <field name="group_ids" eval="[(5,0),(4, ref('stock.group_stock_manager'))]"/>
        </record> -->
    </data>
</odoo>
